# Absolute or relative path to the workspace root (parent of all project folders)
WORKSPACE_PATH=..

# GitHub personal access token — passed to the PHP container for Composer.
# Required for private repos and to avoid GitHub API rate limiting (60 req/h → 5000 req/h).
GITHUB_TOKEN=your_github_token_here

# db-sync: comma-separated database entries.
# Per entry, four formats are accepted:
#   1) name:path                          -> engine=mysql, server picked from DB_SYNC_SERVERS
#   2) name:engine:path                   -> server picked from DB_SYNC_SERVERS
#   3) name:engine:server:path            -> fully bound, no server prompt
#   4) name:engine:srvA|srvB:path         -> prompts to pick among the listed servers
# engine: mysql | postgres
# The path is the remote directory holding the .sql files to pull.
DB_SYNC_DATABASES="my_database:mysql:my-server:/var/www/my-project/shared/var/db_backups"

# Servers used when a DB entry does not bind one explicitly.
# Names as SSH resolves them: a host, or an alias from your ~/.ssh/config.
DB_SYNC_SERVERS="my-server,my-other-server"

# bucket-sync: one entry per place the objects can live.
#   name:server:endpoint:bucket:region
# The copy runs ON the destination server, so nothing passes through this machine.
BUCKET_SYNC_SITES="site-a:server-a:https://s3.example-provider.com:my-bucket-a:region-a,site-b:server-b:https://s3.region-b.amazonaws.com:my-bucket-b:region-b"

# Prefixes offered by the prompt. One per environment sharing the bucket.
BUCKET_SYNC_PREFIXES="prod,staging"

# Image rclone runs from on the destination box.
BUCKET_SYNC_RCLONE_IMAGE=rclone/rclone:latest

# File on the destination box holding its own S3 credentials, as
# AWS_ACCESS_KEY_ID= / AWS_SECRET_ACCESS_KEY= lines. A box running on an
# instance profile publishes none, and rclone uses the role instead.
BUCKET_SYNC_BOX_ENV=/etc/bucket-sync.env

# S3 credentials per site, named after it in upper case. The script prompts for
# whatever is missing, so a site can be left unconfigured.
BUCKET_SYNC_KEY_SITE_A=your_access_key_here
BUCKET_SYNC_SECRET_SITE_A=your_secret_key_here
BUCKET_SYNC_KEY_SITE_B=your_access_key_here
BUCKET_SYNC_SECRET_SITE_B=your_secret_key_here
